# IDADM Course Helper — Streamlit Secrets 範例 (Template)
#
# 自部署時，請將本檔案複製為 .streamlit/secrets.toml 並填入你的真實憑證：
#   cp .streamlit/secrets.example .streamlit/secrets.toml
#
# 注意：.streamlit/secrets.toml 已列入 .gitignore，請勿提交真實憑證。
#       本 .streamlit/secrets.example 僅為公開範本，不含任何私密資訊。

# ============================
# Supabase（必填，應用啟動所需）
# ============================
# 專案網址，格式為 https://<project-ref>.supabase.co
SUPABASE_URL = "https://xxxx.supabase.co"

# Supabase anon key（公開金鑰，非 service_role）
SUPABASE_KEY = "eyJxxxx"

# ============================
# 課程導入 (v1.1 Import Courses) 所需
# ============================
# 視覺語言模型 (Vision LLM) 的 API Key（OpenAI 兼容端點）。
# 必填：未配置時匯入功能會提示金鑰缺失，但不影響其他功能。
LLM_API_KEY = "sk-xxxx"

# 可選：自託管 / 代理端點的 Base URL（OpenAI 兼容，需以 /v1 結尾）。
# 留空則使用 OpenAI 官方端點。
LLM_BASE_URL = "https://your-endpoint/v1"

# 可選：課程導入使用的模型名稱，預設為 gemini-3.5-flash-lite。
COURSE_IMPORT_MODEL = "gemini-3.5-flash-lite"
